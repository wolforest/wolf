<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.coderule</groupId>
        <artifactId>wolf</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.coderule</groupId>
    <artifactId>wolf-boot-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>wolf-boot-parent</name>
    <description>wolf boot parent</description>

    <modules>
        <module>wolf-maven-dependencies</module>
        <module>wolf-dependencies-parent</module>
        <module>wolf-utils-dependencies</module>
        <module>wolf-middleware-dependencies</module>
        <module>wolf-framework-dependencies</module>
        <module>wolf-db-dependencies</module>
        <module>wolf-dubbo-dependencies</module>
        <module>wolf-sdk-dependencies</module>
        <module>wolf-net-dependencies</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>

        <wolf-dependencies.version>${revision}</wolf-dependencies.version>
        <wolf-utils-dependencies.version>${revision}</wolf-utils-dependencies.version>
        <wolf-middleware-dependencies.version>${revision}</wolf-middleware-dependencies.version>
        <wolf-db-dependencies.version>${revision}</wolf-db-dependencies.version>
        <wolf-dubbo-dependencies.version>${revision}</wolf-dubbo-dependencies.version>
        <wolf-sdk-dependencies.version>${revision}</wolf-sdk-dependencies.version>
        <wolf-net-dependencies.version>${revision}</wolf-net-dependencies.version>

    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-framework-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-utils-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-utils-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-net-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-net-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-middleware-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-middleware-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-db-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-db-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-dubbo-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-dubbo-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.coderule</groupId>
                <artifactId>wolf-sdk-dependencies</artifactId>
                <type>pom</type>
                <version>${wolf-sdk-dependencies.version}</version>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <dependencies>

    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>cn.coderule</groupId>
                    <artifactId>wolf-maven-dependencies</artifactId>
                    <version>${wolf-dependencies.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
